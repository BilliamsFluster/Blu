UI:
  Name: GameplayHUD
  Widgets:
    - Type: Column
      Name: HUDPanel
      Position: [18.0, 18.0]
      Size: [320.0, 150.0]
      Padding: [10.0, 10.0]
      Gap: 8.0
      Color: [0.03, 0.035, 0.04, 0.72]
      Children:
        - Type: Text
          Name: Pawn
          Size: [280.0, 18.0]
          FontSize: 14.0
          Binding: PawnName
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: Text
          Name: HealthText
          Size: [280.0, 18.0]
          FontSize: 14.0
          Binding: HealthText
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: ProgressBar
          Name: HealthBar
          Size: [250.0, 14.0]
          Binding: Health
          Color: [0.18, 0.08, 0.08, 0.90]
          FillColor: [0.85, 0.18, 0.18, 1.0]
        - Type: Text
          Name: StaminaText
          Size: [280.0, 18.0]
          FontSize: 14.0
          Binding: StaminaText
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: ProgressBar
          Name: StaminaBar
          Size: [250.0, 14.0]
          Binding: Stamina
          Color: [0.08, 0.12, 0.08, 0.90]
          FillColor: [0.25, 0.80, 0.25, 1.0]
        - Type: Text
          Name: Zombies
          Size: [280.0, 18.0]
          FontSize: 14.0
          Binding: ZombieCount
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: Text
          Name: InteractPrompt
          Size: [280.0, 18.0]
          FontSize: 14.0
          Binding: InteractPrompt
          ForegroundColor: [1.0, 0.82, 0.30, 1.0]

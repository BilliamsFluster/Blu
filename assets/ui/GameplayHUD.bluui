UI:
  Name: GameplayHUD
  Widgets:
    # ── Status panel (top-left) ──────────────────────────────────────────
    - Type: Column
      Name: HUDPanel
      Position: [18.0, 18.0]
      Size: [300.0, 132.0]
      Padding: [10.0, 10.0]
      Gap: 8.0
      Color: [0.03, 0.035, 0.04, 0.72]
      Children:
        - Type: Text
          Name: HealthText
          Size: [270.0, 18.0]
          FontSize: 14.0
          Binding: HealthText
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: ProgressBar
          Name: HealthBar
          Size: [250.0, 14.0]
          Binding: Health
          Color: [0.18, 0.08, 0.08, 0.90]
          FillColor: [0.85, 0.18, 0.18, 1.0]
        - Type: Text
          Name: StaminaText
          Size: [270.0, 18.0]
          FontSize: 14.0
          Binding: StaminaText
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: ProgressBar
          Name: StaminaBar
          Size: [250.0, 14.0]
          Binding: Stamina
          Color: [0.08, 0.12, 0.08, 0.90]
          FillColor: [0.25, 0.80, 0.25, 1.0]
        - Type: Text
          Name: Zombies
          Size: [270.0, 18.0]
          FontSize: 14.0
          Binding: ZombieCount
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
    # ── Ammo readout (bottom-right; sized for the 1280x720 capture) ──────
    - Type: Column
      Name: AmmoPanel
      Position: [1012.0, 648.0]
      Size: [236.0, 54.0]
      Padding: [16.0, 14.0]
      Gap: 0.0
      Color: [0.03, 0.035, 0.04, 0.72]
      Children:
        - Type: Text
          Name: AmmoText
          Size: [210.0, 28.0]
          FontSize: 26.0
          Binding: AmmoText
          ForegroundColor: [1.0, 0.86, 0.45, 1.0]
    # ── Interact prompt (centered, above the ammo panel) ────────────────
    - Type: Text
      Name: InteractPrompt
      Position: [560.0, 470.0]
      Size: [320.0, 18.0]
      FontSize: 16.0
      Binding: InteractPrompt
      ForegroundColor: [1.0, 0.82, 0.30, 1.0]
    # ── Crosshair + hitmarker (auto-centered; Position/Size ignored) ─────
    - Type: Panel
      Name: Reticle
      Binding: Reticle
      ForegroundColor: [0.95, 0.97, 1.0, 0.85]
    - Type: Panel
      Name: Hitmarker
      Binding: Hitmarker
      ForegroundColor: [1.0, 0.32, 0.20, 1.0]

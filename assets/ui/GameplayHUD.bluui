UI:
  Name: GameplayHUD
  Widgets:
    # ── Status panel (top-left) ──────────────────────────────────────────
    - Type: Column
      Name: HUDPanel
      Position: [18.0, 18.0]
      Size: [360.0, 200.0]
      Padding: [12.0, 12.0]
      Gap: 8.0
      Color: [0.03, 0.035, 0.04, 0.72]
      Children:
        - Type: Text
          Name: HealthText
          Size: [330.0, 24.0]
          FontSize: 20.0
          Binding: HealthText
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: ProgressBar
          Name: HealthBar
          Size: [320.0, 18.0]
          Binding: Health
          Color: [0.18, 0.08, 0.08, 0.90]
          FillColor: [0.85, 0.18, 0.18, 1.0]
        - Type: Text
          Name: StaminaText
          Size: [330.0, 24.0]
          FontSize: 20.0
          Binding: StaminaText
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: ProgressBar
          Name: StaminaBar
          Size: [320.0, 18.0]
          Binding: Stamina
          Color: [0.08, 0.12, 0.08, 0.90]
          FillColor: [0.25, 0.80, 0.25, 1.0]
        - Type: Text
          Name: Zombies
          Size: [330.0, 24.0]
          FontSize: 20.0
          Binding: ZombieCount
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
    # ── Objective panel (top-right; wave / score / lives) ───────────────
    - Type: Column
      Name: ObjectivePanel
      Position: [966.0, 18.0]
      Size: [296.0, 128.0]
      Padding: [14.0, 12.0]
      Gap: 6.0
      Color: [0.03, 0.035, 0.04, 0.72]
      Children:
        - Type: Text
          Name: WaveText
          Size: [268.0, 30.0]
          FontSize: 26.0
          Binding: Wave
          ForegroundColor: [1.0, 0.86, 0.45, 1.0]
        - Type: Text
          Name: ScoreText
          Size: [268.0, 24.0]
          FontSize: 20.0
          Binding: Score
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
        - Type: Text
          Name: LivesText
          Size: [268.0, 24.0]
          FontSize: 20.0
          Binding: Lives
          ForegroundColor: [0.92, 0.94, 0.96, 1.0]
    # ── Ammo readout (bottom-right; sized for the 1280x720 capture) ──────
    - Type: Column
      Name: AmmoPanel
      Position: [950.0, 624.0]
      Size: [312.0, 78.0]
      Padding: [18.0, 16.0]
      Gap: 0.0
      Color: [0.03, 0.035, 0.04, 0.72]
      Children:
        - Type: Text
          Name: AmmoText
          Size: [276.0, 40.0]
          FontSize: 38.0
          Binding: AmmoText
          ForegroundColor: [1.0, 0.86, 0.45, 1.0]
    # ── Interact prompt (centered, above the ammo panel) ────────────────
    - Type: Text
      Name: InteractPrompt
      Position: [520.0, 458.0]
      Size: [360.0, 26.0]
      FontSize: 22.0
      Binding: InteractPrompt
      ForegroundColor: [1.0, 0.82, 0.30, 1.0]
    # ── Crosshair + hitmarker (auto-centered; Position/Size ignored) ─────
    - Type: Panel
      Name: Reticle
      Binding: Reticle
      ForegroundColor: [0.95, 0.97, 1.0, 0.85]
    - Type: Panel
      Name: Hitmarker
      Binding: Hitmarker
      ForegroundColor: [1.0, 0.32, 0.20, 1.0]
